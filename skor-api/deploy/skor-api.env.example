# skor-api ayarları — örnek. kurulum.sh gerçeğini /etc/skor-api.env olarak rastgele değerlerle yazar.
# Elle çalıştırırken: set -a; . ./deploy/skor-api.env.example; set +a

# HMAC anahtarı (en az 32 karakter): openssl rand -hex 32
SKOR_SECRET=degistir-bunu-en-az-32-karakter-rastgele-yaz
SKOR_DB_HOST=127.0.0.1
SKOR_DB_PORT=3306
SKOR_DB_USER=oyun
SKOR_DB_PASSWORD=degistir
SKOR_DB_NAME=oyun
SKOR_DB_POOL=4
# İzin verilen kaynaklar (CORS), virgülle
SKOR_ALLOWED_ORIGINS=https://hamikumbasae.github.io
# http(s)://localhost ve 127.0.0.1 her portta (yerel geliştirme ve Android uygulaması)
SKOR_ALLOW_LOCALHOST=1
# Bağlantı 127.0.0.1'den (cloudflared) geliyorsa CF-Connecting-IP / X-Forwarded-For başlığına güven
SKOR_TRUST_PROXY=1
# Koşu jetonunun ömrü (saniye)
SKOR_RUN_MAX_AGE=43200
